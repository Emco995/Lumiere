generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salon {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  city         String
  address      String
  rating       Float     @default(5.0)
  reviewsCount Int       @default(0)
  coverImage   String?
  badge        String?
  stripeAcctId String?
  stylists     Stylist[]
  services     Service[]
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Stylist {
  id               String            @id @default(cuid())
  salonId          String
  salon            Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name             String
  role             String
  avatar           String?
  rating           Float             @default(5.0)
  reviewsCount     Int               @default(0)
  specialties      String[]
  isOnVacation     Boolean           @default(false)
  vacationUntil    String?
  substituteId     String?
  matchScore       Int?              @default(95)
  googleCalendarId String?
  availabilities   StylistSchedule[]
  bookings         Booking[]
  createdAt        DateTime          @default(now())
}

model StylistSchedule {
  id        String  @id @default(cuid())
  stylistId String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  dayOfWeek Int     // 0 = Nedjelja, 1 = Ponedjeljak ... 6 = Subota
  startTime String  // "09:00"
  endTime   String  // "18:00"
  isWorking Boolean @default(true)
}

model Service {
  id          String    @id @default(cuid())
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  category    String    // "Kosa" | "Nokti" | "Masaža" | "Lice & Tijelo"
  durationMin Int
  priceEur    Float
  description String?
  bookings    Booking[]
}

model Client {
  id         String            @id @default(cuid())
  fullName   String
  email      String?           @unique
  phone      String            @unique
  styleCards ClientStyleCard[]
  bookings   Booking[]
  createdAt  DateTime          @default(now())
}

model ClientStyleCard {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  String   // npr. "Kosa" ili "Nokti"
  formula   String   // npr. "Koleston 7.1 + 8.0, hidrogen 6%, Olaplex No.2"
  notes     String?  // npr. "Osjetljivo vlasište, preferira blage talase"
  updatedAt DateTime @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  stylistId       String
  stylist         Stylist  @relation(fields: [stylistId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  date            String   // "2026-11-22"
  timeSlot        String   // "14:00"
  status          String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED
  paymentMethod   String   @default("SALON") // SALON | STRIPE | PAYPAL
  paymentStatus   String   @default("UNPAID") // UNPAID | DEPOSIT_PAID | PAID
  isSubstitute    Boolean  @default(false)
  originalStylist String?
  styleSnapshot   String?
  createdAt       DateTime @default(now())
}